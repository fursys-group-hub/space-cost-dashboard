# ──────────────────────────────────────────────────────────────
# space-cost-dashboard — 환경변수 (데이터 분석 / FastAPI)
# ──────────────────────────────────────────────────────────────
# ⚠️ 시크릿은 서버에서만 사용됩니다. 절대 클라이언트/응답에 노출하지 마세요.
#    운영 배포 시에는 Coolify Environment Variables 에 Locked=Yes 로 등록하세요.
#
# MSSQL 데이터베이스 접속
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DATABASE=

# ── fgdw (사내 MSSQL Data Warehouse) 접속 ──────────────────────
# 서버사이드 전용. app/fgdw.py 가 이 값들을 읽습니다.
#
# 로컬 개발: FGDW_DB_USER / FGDW_DB_PASSWORD 에 "본인 fgdw 개발 계정" 을 넣으세요.
# 배포 시: 중앙 배포 프록시가 USER/PASSWORD 를 사내 공용 시스템계정으로 강제 치환하고
#          HOST/NAME 을 정규화합니다 → 실무자는 공용 비번을 몰라도 됩니다.
# 실제 비밀번호를 repo 에 커밋하지 마세요(.env 는 gitignore, .env.example 만 커밋).
FGDW_DB_HOST=192.9.201.23,1672
FGDW_DB_PORT=1672
FGDW_DB_NAME=fgdw
FGDW_DB_USER=
FGDW_DB_PASSWORD=
